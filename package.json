{
  "name": "language-text",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "description": "Plain text support.",
  "keywords": [
    "txt",
    "plaintext",
    "prose",
    "tree-sitter"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-todo"
  ],
  "repository": "https://github.com/lumine-code/language-text",
  "license": "MIT",
  "files": [
    "grammars",
    "lib",
    "snippets",
    "spec"
  ],
  "bugs": {
    "url": "https://github.com/lumine-code/language-text/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "todo.injection": {
      "versions": {
        "^1.0.0": "consumeTodoInjection"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
